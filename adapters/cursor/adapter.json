{
  "host": "cursor",
  "displayName": "Cursor",
  "integrationPriority": "plugin-first",
  "plugin": {
    "mode": "plugin",
    "skillsPath": "skills",
    "manifest": ".codex-plugin/plugin.json"
  },
  "skills": {
    "mode": "plugin",
    "path": "skills"
  },
  "instructions": {
    "plugin": ".cursor-plugin",
    "requiresBackup": true
  },
  "superpowers": {
    "required": true,
    "install": "/add-plugin superpowers"
  },
  "checks": [
    "superpowers",
    "skills-catalog",
    "plugin-install",
    "cursor-plugin-manifest",
    "compatibility-bridge-optional"
  ],
  "compatibilityBridge": {
    "optional": true,
    "protocol": "mcp",
    "transport": "stdio",
    "command": "dyslexia",
    "args": [
      "mcp"
    ],
    "note": "Use only for hosts or workflows that cannot consume the skills plugin directly."
  }
}
