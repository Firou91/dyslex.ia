{
  "host": "antigravity",
  "displayName": "Antigravity",
  "integrationPriority": "plugin-first",
  "plugin": {
    "mode": "plugin",
    "skillsPath": "skills",
    "manifest": ".codex-plugin/plugin.json"
  },
  "skills": {
    "mode": "plugin",
    "path": "skills"
  },
  "mcpCompatibility": {
    "optional": true,
    "transport": "stdio",
    "command": "dyslexia",
    "args": [
      "mcp"
    ]
  },
  "instructions": {
    "hook": "session-start",
    "requiresBackup": true
  },
  "superpowers": {
    "required": true,
    "install": "agy plugin install https://github.com/obra/superpowers"
  },
  "checks": [
    "superpowers",
    "skills-catalog",
    "plugin-install",
    "session-start-hook",
    "mcp-stdio-optional"
  ]
}
