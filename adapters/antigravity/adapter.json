{
  "host": "antigravity",
  "displayName": "Antigravity",
  "integrationPriority": "plugin-first",
  "plugin": {
    "mode": "plugin",
    "skillsPath": "skills",
    "manifest": ".codex-plugin/plugin.json"
  },
  "skills": {
    "mode": "plugin",
    "path": "skills"
  },
  "instructions": {
    "hook": "session-start",
    "requiresBackup": true
  },
  "superpowers": {
    "required": true,
    "install": "agy plugin install https://github.com/obra/superpowers"
  },
  "checks": [
    "superpowers",
    "skills-catalog",
    "plugin-install",
    "session-start-hook"
  ]
}
