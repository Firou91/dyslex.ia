{
  "host": "pi",
  "displayName": "Pi",
  "integrationPriority": "plugin-first",
  "plugin": {
    "mode": "package",
    "skillsPath": "skills",
    "manifest": ".pi"
  },
  "skills": {
    "mode": "package",
    "path": "skills"
  },
  "instructions": {
    "package": ".pi",
    "requiresBackup": true
  },
  "superpowers": {
    "required": true,
    "install": "pi install git:github.com/obra/superpowers"
  },
  "checks": [
    "superpowers",
    "skills-catalog",
    "plugin-install",
    "pi-package",
    "compatibility-bridge-optional"
  ],
  "compatibilityBridge": {
    "optional": true,
    "protocol": "mcp",
    "transport": "stdio",
    "command": "dyslexai",
    "args": [
      "mcp"
    ],
    "note": "Use only for hosts or workflows that cannot consume the skills plugin directly."
  }
}
