{
  "host": "kimi-code",
  "displayName": "Kimi Code",
  "integrationPriority": "plugin-first",
  "plugin": {
    "mode": "plugin",
    "skillsPath": "skills",
    "manifest": ".codex-plugin/plugin.json"
  },
  "skills": {
    "mode": "plugin",
    "path": "skills"
  },
  "instructions": {
    "plugin": ".kimi-plugin",
    "requiresBackup": true
  },
  "superpowers": {
    "required": true,
    "install": "/plugins install https://github.com/obra/superpowers"
  },
  "checks": [
    "superpowers",
    "skills-catalog",
    "plugin-install",
    "kimi-plugin-manifest"
  ]
}
