{
  "host": "copilot-cli",
  "displayName": "GitHub Copilot CLI",
  "integrationPriority": "plugin-first",
  "plugin": {
    "mode": "plugin",
    "skillsPath": "skills",
    "manifest": ".codex-plugin/plugin.json"
  },
  "skills": {
    "mode": "plugin",
    "path": "skills"
  },
  "instructions": {
    "plugin": "copilot plugin",
    "requiresBackup": true
  },
  "superpowers": {
    "required": true,
    "install": "copilot plugin marketplace add obra/superpowers-marketplace && copilot plugin install superpowers@superpowers-marketplace"
  },
  "checks": [
    "superpowers",
    "skills-catalog",
    "plugin-install",
    "copilot-plugin",
    "compatibility-bridge-optional"
  ],
  "compatibilityBridge": {
    "optional": true,
    "protocol": "mcp",
    "transport": "stdio",
    "command": "dyslexai",
    "args": [
      "mcp"
    ],
    "note": "Use only for hosts or workflows that cannot consume the skills plugin directly."
  }
}
