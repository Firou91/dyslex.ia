{
  "host": "claude-code",
  "displayName": "Claude Code",
  "integrationPriority": "plugin-first",
  "plugin": {
    "mode": "plugin",
    "skillsPath": "skills",
    "manifest": ".codex-plugin/plugin.json"
  },
  "skills": {
    "mode": "plugin",
    "path": "skills"
  },
  "instructions": {
    "file": "CLAUDE.md",
    "requiresBackup": true
  },
  "superpowers": {
    "required": true,
    "install": "/plugin install superpowers@claude-plugins-official"
  },
  "checks": [
    "superpowers",
    "skills-catalog",
    "plugin-install",
    "instructions-backup"
  ]
}
