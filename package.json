{
  "name": "@firou91/dyslex.ai",
  "version": "0.3.5",
  "description": "Accessibility skills plugin for AI agents on top of Superpowers.",
  "type": "module",
  "license": "Apache-2.0",
  "main": "./dist/src/cli/index.js",
  "exports": {
    ".": "./dist/src/cli/index.js",
    "./cli": "./dist/src/cli/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "dyslexai": "dist/src/cli/index.js",
    "dyslex.ai": "dist/src/cli/index.js"
  },
  "files": [
    ".codex-plugin",
    "dist/src",
    "skills",
    "adapters",
    "docs",
    "LICENSE",
    "README.md",
    "SECURITY.md"
  ],
  "keywords": [
    "accessibility",
    "dyslexia",
    "dyslexai",
    "plugin",
    "agent-skills",
    "superpowers",
    "codex"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Firou91/dyslex.ai.git"
  },
  "homepage": "https://github.com/Firou91/dyslex.ai#readme",
  "bugs": {
    "url": "https://github.com/Firou91/dyslex.ai/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node scripts/clean-dist.mjs",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "skills:validate": "node scripts/validate-skills.mjs",
    "plugin:validate": "node scripts/validate-plugin.mjs",
    "test": "npm run build && node --test --test-concurrency=1 dist/tests/*.test.js dist/tests/integration/*.test.js",
    "doctor": "node dist/src/cli/index.js doctor",
    "pack:dry-run": "npm pack --dry-run --cache .test/npm-cache",
    "prepublishOnly": "pnpm typecheck && pnpm lint && pnpm skills:validate && pnpm plugin:validate && pnpm test && pnpm build && npm pack --dry-run --cache .test/npm-cache"
  },
  "dependencies": {
    "env-paths": "^3.0.0",
    "semver": "^7.7.2",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.24.6"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/semver": "^7.7.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
